{
  "name": "stc-toolkit",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.3.2",
  "publisher": "SiboXu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.uvproj",
    "workspaceContains:**/*.uvprojx",
    "onCommand:stcToolkit.build",
    "onCommand:stcToolkit.rebuild",
    "onCommand:stcToolkit.flash",
    "onCommand:stcToolkit.buildFlash",
    "onCommand:stcToolkit.selectPort",
    "onCommand:stcToolkit.selectFirmware",
    "onCommand:stcToolkit.selectBackend",
    "onCommand:stcToolkit.openOfficialIsp",
    "onCommand:stcToolkit.detectFirmware"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stcToolkit.build",
        "title": "%command.build%",
        "icon": "$(tools)"
      },
      {
        "command": "stcToolkit.rebuild",
        "title": "%command.rebuild%",
        "icon": "$(sync)"
      },
      {
        "command": "stcToolkit.flash",
        "title": "%command.flash%",
        "icon": "$(zap)"
      },
      {
        "command": "stcToolkit.buildFlash",
        "title": "%command.buildFlash%",
        "icon": "$(rocket)"
      },
      {
        "command": "stcToolkit.selectBackend",
        "title": "%command.selectBackend%"
      },
      {
        "command": "stcToolkit.selectPort",
        "title": "%command.selectPort%"
      },
      {
        "command": "stcToolkit.detectFirmware",
        "title": "%command.detectFirmware%",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "stcToolkit.selectFirmware",
        "title": "%command.selectFirmware%"
      },
      {
        "command": "stcToolkit.openOfficialIsp",
        "title": "%command.openOfficialIsp%"
      },
      {
        "command": "stcToolkit.showInfo",
        "title": "%command.showInfo%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "stcToolkit.projectFile": {
          "type": "string",
          "default": "",
          "description": "%config.projectFile.description%"
        },
        "stcToolkit.keil.uv4Path": {
          "type": "string",
          "default": "",
          "description": "%config.keilUv4Path.description%"
        },
        "stcToolkit.build.customCommand": {
          "type": "string",
          "default": "",
          "description": "%config.buildCustomCommand.description%"
        },
        "stcToolkit.firmwareFile": {
          "type": "string",
          "default": "",
          "description": "%config.firmwareFile.description%"
        },
        "stcToolkit.flash.backend": {
          "type": "string",
          "enum": [
            "auto",
            "stcgal",
            "native-hid",
            "official",
            "custom"
          ],
          "default": "auto",
          "description": "%config.flashBackend.description%",
          "enumDescriptions": [
            "%config.flashBackend.auto%",
            "%config.flashBackend.stcgal%",
            "%config.flashBackend.nativeHid%",
            "%config.flashBackend.official%",
            "%config.flashBackend.custom%"
          ]
        },
        "stcToolkit.flash.stcgalPath": {
          "type": "string",
          "default": "stcgal",
          "description": "%config.stcgalPath.description%"
        },
        "stcToolkit.flash.protocol": {
          "type": "string",
          "enum": [
            "auto",
            "stc89",
            "stc12a",
            "stc12b",
            "stc12",
            "stc15a",
            "stc15",
            "stc8",
            "stc8d",
            "stc8g",
            "usb15"
          ],
          "default": "auto",
          "description": "%config.flashProtocol.description%"
        },
        "stcToolkit.flash.port": {
          "type": "string",
          "default": "",
          "description": "%config.flashPort.description%"
        },
        "stcToolkit.flash.baud": {
          "type": "number",
          "default": 115200,
          "minimum": 1200,
          "maximum": 3000000,
          "description": "%config.flashBaud.description%"
        },
        "stcToolkit.flash.autoreset": {
          "type": "boolean",
          "default": false,
          "description": "%config.flashAutoreset.description%"
        },
        "stcToolkit.flash.pythonPath": {
          "type": "string",
          "default": "",
          "description": "%config.pythonPath.description%"
        },
        "stcToolkit.flash.nativeHidExperimental": {
          "type": "boolean",
          "default": false,
          "description": "%config.nativeHidExperimental.description%"
        },
        "stcToolkit.flash.nativeHidAutoReset": {
          "type": "boolean",
          "default": false,
          "description": "%config.nativeHidAutoReset.description%"
        },
        "stcToolkit.flash.nativeHidResetCommand": {
          "type": "string",
          "default": "@STCISP#",
          "description": "%config.nativeHidResetCommand.description%"
        },
        "stcToolkit.flash.customCommand": {
          "type": "string",
          "default": "",
          "description": "%config.flashCustomCommand.description%"
        },
        "stcToolkit.officialIspPath": {
          "type": "string",
          "default": "",
          "description": "%config.officialIspPath.description%"
        },
        "stcToolkit.ui.showEditorButtons": {
          "type": "boolean",
          "default": true,
          "description": "%config.showEditorButtons.description%"
        },
        "stcToolkit.ui.showSuccessNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.showSuccessNotifications.description%"
        },
        "stcToolkit.firmware.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "%config.firmwareAutoDetect.description%"
        },
        "stcToolkit.firmware.preferFreshBuild": {
          "type": "boolean",
          "default": true,
          "description": "%config.preferFreshBuild.description%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "stcToolkit.build",
          "when": "config.stcToolkit.ui.showEditorButtons && (resourceLangId == c || resourceLangId == cpp)",
          "group": "navigation@1"
        },
        {
          "command": "stcToolkit.flash",
          "when": "config.stcToolkit.ui.showEditorButtons && (resourceLangId == c || resourceLangId == cpp)",
          "group": "navigation@2"
        },
        {
          "command": "stcToolkit.buildFlash",
          "when": "config.stcToolkit.ui.showEditorButtons && (resourceLangId == c || resourceLangId == cpp)",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --check extension.js && node --check lib/device-db.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/siqi5893-hub/stc-toolkit.git"
  },
  "homepage": "https://github.com/siqi5893-hub/stc-toolkit#readme",
  "bugs": {
    "url": "https://github.com/siqi5893-hub/stc-toolkit/issues"
  }
}
